# API 키와 모델 설정. 이 파일을 .env 로 복사해 값을 채우세요. (값에 따옴표는 붙여도 되고 안 붙여도 됩니다)
# main.py 와 scripts/ 가 시작할 때 읽습니다. 이미 설정된 환경변수가 있으면 그 값을 우선합니다.
# 주석은 별도 줄에 두세요. 값 뒤에 같은 줄로 붙이면 값의 일부로 읽힙니다.

# ── 필수 ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
TAVILY_API_KEY=

# ── 선택 ──────────────────────────────────────────────────────────────────────
# LLM 모델. 비워 두면 gpt-5.1 (code/core/config.py 의 DEFAULT_LLM_MODEL). 모든 에이전트가 같은 모델을 쓴다.
# 경량 모델(gpt-4o-mini 등)은 계획서 양식(### 소제목·모듈 구조·인용 형식)을 지키지 못하는 경우가 많아 심사 통과와 참고문헌 생성이 어렵다.
OPENAI_MODEL=gpt-5.1

# 학술 검색. 있으면 Collector C 가 Liner Scholar Search + arXiv 초록 보강, 없으면 arXiv 검색만.
LINER_API_KEY=

# 학술 검색 백엔드 강제 (auto | liner | arxiv). 비워 두면 auto = LINER_API_KEY 유무로 결정.
SCHOLAR_BACKEND=

# 도해용 Chrome/Chromium 실행 파일 경로. 비워 두면 Playwright 번들 브라우저(playwright install chromium)를 쓴다.
CHROME_PATH=
